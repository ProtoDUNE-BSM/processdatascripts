#include "run_master_np04data_processor.fcl"

# 31107 is a long 57-hour SPS spill-on run

services.DetectorPropertiesService.NumberTimeSamples: 7500
services.DetectorPropertiesService.ReadOutWindowSize: 7500

# These det clock parameters seem to break the reconstruction - do not know why
#services.DetectorClocksService.TriggerOffsetTPC: -2750. # Time [us] for TPC readout start w.r.t. trigger time
#services.DetectorClocksService.G4RefTime: -2750.

physics.producers.spillflag.sps_beamdata: "spillrun031107.csv"
physics.filters.filterspillon.sps_beamdata: "spillrun031107.csv"

# Set correct gain for wirecell - already set correctly in master for decoder
physics.producers.wclsdatahd.wcls_main.structs.elecGain: 7.8 # mV/fC 

# Pandora can get stuck if there are too many hits to cluster
# Would normally scale HitLimit with length of window                     
# - but with this trigger the hits are concentrated in a short time period
# so do not need to change the hit limit                                  
physics.filters.nhitsfilter.HitLimit: 80000
physics.filters.nhitsfilter.ScaleThresholdForReadoutWindow: false
physics.filters.nhitsfilter.Verbose: true

physics.produce: [
  # Raw decoding
  spillflag, # Add a producer for SPS spill on/off
  triggerrawdecoder,
  triggertypefilter, # Filter for ground shakes
  tpcrawdecoder,
  timingrawdecoder,
  # Signal processing
  fembfilter,
  wclsdatahd,
  # Hit finding
  gaushit,
  reco3d,
  hitpdune,
  # Remove events that have too many events for pandora to handle
  nhitsfilter,
  # Pandora reconstruction
  pandora, 
  pandoraWriter, 
  pandoraTrack, 
  pandoraShower, 
  pandoracalo, 
  pandoracalonosce,
  pandorapid, 
  pandoraShowercalo, 
  pandoraShowercalonosce
]
